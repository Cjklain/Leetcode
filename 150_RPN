class Solution3:
    def evalRPN(self, tokens: list[str]) -> int:
        stack_helper = []
        set_help = ("+", "-", "/", "*")
        for token in tokens:
            if token in set_help:
                top_value = stack_helper.pop()
                second_value = stack_helper.pop()
                temp = 0
                if token == "+":
                    temp = second_value + top_value
                if token == "-":
                    temp = second_value - top_value
                if token == "/":
                    temp = int(second_value / top_value)
                    print(temp)
                if token == "*":
                    temp = second_value * top_value
                stack_helper.append(temp)
            else:
                stack_helper.append(int(token))

        return stack_helper.pop()


